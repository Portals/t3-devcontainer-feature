#!/usr/bin/env bash
set -euo pipefail
source /etc/t3-code.env
[[ "$(id -un)" == "$T3_DEV_USER" ]]
source /usr/local/share/t3-code/server-state.sh
unmanaged() {
    if [[ -n "$(t3_listener_inodes)" ]]; then
        echo 'The endpoint is running without its recorded supervisor; refusing to stop an unknown process.' >&2
        exit 1
    fi
    exit 0
}
pid=$(t3_supervisor_pid) || unmanaged
mapfile -t members < <(ps -eo pid=,pgid= | awk -v group="$pid" '$2 == group { print $1 }')
declare -A started
for member in "${members[@]}"; do
    if stat=$(cat "/proc/$member/stat" 2>/dev/null); then
        read -ra fields <<< "${stat##*) }"
        started[$member]=${fields[19]}
    fi
done
kill -TERM -- "-$pid"
for _attempt in {1..300}; do
    waiting=false
    for member in "${!started[@]}"; do
        if stat=$(cat "/proc/$member/stat" 2>/dev/null); then
            read -ra fields <<< "${stat##*) }"
            if [[ "${fields[19]}" == "${started[$member]}" && "${fields[0]}" != Z ]]; then waiting=true; fi
        fi
    done
    [[ "$waiting" == true ]] || exit 0
    sleep 0.1
done
echo 'T3 processes have not finished shutting down; update was not activated.' >&2
exit 1
